  "options": { "format": "mp4", "quality": "high" },
  "output": {
    "sink": "webhook",
    "config": {
      "url": "https://intake.internal.example/renders",
      "headers": { "Authorization": "Bearer REPLACE_ME" }
    }
  }
}
