{
  "name": "escapesuite",
  "private": true,
  "version": "1.0.0",
  "description": "Privacy-first, client-side media creation tools",
  "author": "Bonham Technologies, LLC",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:plan": "turbo dev --filter=@escapesuite/plan",
    "dev:craft": "turbo dev --filter=@escapesuite/craft",
    "dev:artist": "turbo dev --filter=@escapesuite/artist",
    "build": "turbo build",
    "build:plan": "turbo build --filter=@escapesuite/plan",
    "build:craft": "turbo build --filter=@escapesuite/craft",
    "build:artist": "turbo build --filter=@escapesuite/artist",
    "build:standalone": "pnpm --filter=@escapesuite/craft run build:standalone && pnpm --filter=@escapesuite/artist run build:standalone",
    "build:deploy": "node scripts/build-all.mjs",
    "lint": "turbo lint",
    "test": "turbo test:run",
    "test:watch": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test --filter=@escapesuite/e2e",
    "test:e2e:browsers": "pnpm --filter=@escapesuite/e2e run test:browsers",
    "test:e2e:browsers:all": "pnpm --filter=@escapesuite/e2e run test:browsers:all",
    "test:e2e:standalone": "pnpm --filter=@escapesuite/e2e run test:standalone",
    "clean": "turbo clean && rm -rf node_modules && rm -rf dist",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset tag",
    "release": "changeset version && changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.11"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.20.1": "^8.20.1"
    }
  }
}
