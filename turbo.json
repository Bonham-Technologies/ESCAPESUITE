{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // @escapesuite/shared's `build` script is a no-op (the package ships its own
    // TypeScript sources; there is no compiled dist/ for consumers to read), so it
    // never produces anything under the default `build` task's `dist/**` outputs —
    // overridden here with no outputs declared, which is also what silences
    // turbo's "no output files found for task @escapesuite/shared#build" warning.
    "@escapesuite/shared#build": {
      "outputs": []
    },
    // The kit assembler shells out to the artist's own build:headless, so the two must never
    // run concurrently, and an artist source change has to invalidate the kit. The service
    // deliberately has NO `workspace:` dependency on @escapesuite/artist — that would ship an
    // uninstallable package.json inside the kit tarball — so the edge and the extra hash
    // inputs are declared here instead of inferred from the dependency graph.
    "@escapesuite/headless-artist#build": {
      "dependsOn": ["@escapesuite/artist#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../apps/artist/src/**",
        "../../apps/artist/headless.html",
        "../../apps/artist/vite.config.ts"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "cache": false,
      "persistent": true
    },
    "test:run": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
