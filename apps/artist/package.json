{
  "name": "@escapesuite/artist",
  "private": true,
  "version": "2.18.27",
  "description": "Client-side web video editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "cross-env-shell VITE_BUILD_MODE=standalone \"tsc -b && vite build\"",
    "build:headless": "cross-env VITE_HEADLESS=true vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fuzz": "cross-env ARTIST_FUZZ_RUNS=5000 vitest run src/store/__tests__/timelineInvariants.property.test.ts",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "video",
    "editor",
    "webcodecs"
  ],
  "author": "Bonham Technologies, LLC",
  "license": "Apache-2.0",
  "dependencies": {
    "@escapesuite/shared": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "gifenc": "1.0.3",
    "idb": "^8.0.4",
    "mediabunny": "^1.65.0",
    "mp4box": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "rollup": "^4.67.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
