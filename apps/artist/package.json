{
  "name": "@escapesuite/artist",
  "private": true,
  "version": "2.0.0",
  "description": "Client-side web video editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:standalone": "cross-env-shell VITE_BUILD_MODE=standalone \"tsc && vite build\"",
    "build:headless": "cross-env VITE_HEADLESS=true vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "video",
    "editor",
    "webcodecs"
  ],
  "author": "Bonham Technologies, LLC",
  "license": "MIT",
  "dependencies": {
    "@escapesuite/shared": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "idb": "^8.0.3",
    "mediabunny": "^1.34.3",
    "mp4box": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "rollup": "^4.62.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
