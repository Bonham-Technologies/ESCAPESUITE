# Build Mode: 'saas' (default) or 'standalone'
VITE_BUILD_MODE=saas

# Supabase (required for SaaS mode — also handles authentication)
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Public Key to check License for validity
VITE_LICENSE_PUBLIC_KEY=some_key...

# License Key (required for standalone mode only)
# VITE_LICENSE_KEY=eyJ...signature
