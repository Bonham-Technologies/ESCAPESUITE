{
  /* Test-only project. tsconfig.app.json deliberately excludes the tests so a
     production build never compiles them; this project puts them back under the
     type checker (see the `typecheck` script and CI's TypeScript check step).
     It includes all of `src` because the tests import freely from it. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest", "node"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": []
}
