# =============================================================================
# ESCAPESUITE - ESCAPEPLAN Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# See docs/ENVIRONMENT_SETUP.md for detailed setup instructions.
# =============================================================================

# =============================================================================
# CLERK - Authentication (Required)
# =============================================================================
# Get from: https://dashboard.clerk.com → API Keys
# Use pk_test_ for development, pk_live_ for production
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# STRIPE - Payments (Required)
# =============================================================================
# Get from: https://dashboard.stripe.com/apikeys
# Use pk_test_ for development, pk_live_ for production
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Individual Subscription Price IDs
# -----------------------------------------------------------------------------
# Create products in Stripe Dashboard → Products
# Copy the Price ID (starts with price_) after creating each price
VITE_STRIPE_PRICE_PRO_MONTHLY=price_xxx
VITE_STRIPE_PRICE_PRO_ANNUAL=price_xxx
VITE_STRIPE_PRICE_FOUNDING=price_xxx

# -----------------------------------------------------------------------------
# Team/Enterprise Subscription Price IDs
# -----------------------------------------------------------------------------
# NOTE: Team pricing is handled server-side by Edge Functions.
# The VITE_* variables below are for display purposes only (optional).
# The actual price lookups use Supabase secrets (see bottom of this file).
# VITE_STRIPE_PRICE_TEAM_SEAT=price_xxx       # Optional: for UI display
# VITE_STRIPE_PRICE_ENTERPRISE_SEAT=price_xxx # Optional: for UI display

# -----------------------------------------------------------------------------
# Standalone License Price IDs (one-time payments)
# -----------------------------------------------------------------------------
# ESCAPECRAFT
VITE_STRIPE_PRICE_CRAFT_STANDARD=price_xxx
VITE_STRIPE_PRICE_CRAFT_PRO=price_xxx
VITE_STRIPE_PRICE_CRAFT_LIFETIME=price_xxx

# ESCAPEARTIST
VITE_STRIPE_PRICE_ARTIST_STANDARD=price_xxx
VITE_STRIPE_PRICE_ARTIST_PRO=price_xxx
VITE_STRIPE_PRICE_ARTIST_LIFETIME=price_xxx

# Suite Bundle (both apps)
VITE_STRIPE_PRICE_SUITE_STANDARD=price_xxx
VITE_STRIPE_PRICE_SUITE_PRO=price_xxx
VITE_STRIPE_PRICE_SUITE_LIFETIME=price_xxx

# =============================================================================
# SUPABASE - Backend Database & Edge Functions (Required)
# =============================================================================
# Get from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxx

# =============================================================================
# OPTIONAL - Additional Services
# =============================================================================

# Sentry - Error Monitoring
# Get from: https://sentry.io → Project Settings → Client Keys
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Build Mode - Controls feature flags
# saas = full SaaS features (default)
# standalone = offline-only desktop app features
# VITE_BUILD_MODE=saas

# =============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# =============================================================================
# These are NOT set in .env.local - they go in Supabase Dashboard:
# Project → Settings → Edge Functions → Secrets
#
# -----------------------------------------------------------------------------
# Core Infrastructure (Required)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxx              # Stripe secret API key
# STRIPE_WEBHOOK_SECRET=whsec_xxx            # Stripe webhook signing secret
# SUPABASE_URL=https://xxx.supabase.co       # Auto-set by Supabase
# SUPABASE_SERVICE_ROLE_KEY=eyJxxx           # Auto-set by Supabase
#
# -----------------------------------------------------------------------------
# License Management (Required for standalone licenses)
# -----------------------------------------------------------------------------
# LICENSE_PRIVATE_KEY=<64-char-hex>          # Ed25519 private key for signing
# LICENSE_PUBLIC_KEY=<64-char-hex>           # Ed25519 public key for validation
#
# -----------------------------------------------------------------------------
# Team/Organization Stripe Prices (Required for team checkout)
# -----------------------------------------------------------------------------
# STRIPE_PRICE_TEAM_MONTHLY=price_xxx        # Team monthly per-seat
# STRIPE_PRICE_TEAM_ANNUAL=price_xxx         # Team annual per-seat
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx  # Enterprise monthly per-seat
# STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxx   # Enterprise annual per-seat
#
# -----------------------------------------------------------------------------
# Standalone License Stripe Prices (Required for license checkout)
# -----------------------------------------------------------------------------
# STRIPE_PRICE_CRAFT_STANDARD=price_xxx
# STRIPE_PRICE_CRAFT_PRO=price_xxx
# STRIPE_PRICE_CRAFT_LIFETIME=price_xxx
# STRIPE_PRICE_ARTIST_STANDARD=price_xxx
# STRIPE_PRICE_ARTIST_PRO=price_xxx
# STRIPE_PRICE_ARTIST_LIFETIME=price_xxx
# STRIPE_PRICE_SUITE_STANDARD=price_xxx
# STRIPE_PRICE_SUITE_PRO=price_xxx
# STRIPE_PRICE_SUITE_LIFETIME=price_xxx
#
# -----------------------------------------------------------------------------
# Optional Services
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_xxx                      # Email service for license delivery
# APP_URL=https://escapesuite.io             # Base URL for invite links
#
# See docs/ENVIRONMENT_SETUP.md for detailed setup instructions
# =============================================================================
